{
  "name": "expenseflow-backend",
  "version": "1.0.0",
  "description": "ExpenseFlow Backend API — Node.js + Express + MongoDB",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --testPathPattern=expenseService --runInBand --forceExit",
    "test:api": "jest --testPathPattern=expenseApi --runInBand --forceExit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "testMatch": [
      "**/src/__tests__/**/*.test.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "8.5.1"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "nodemon": "3.1.4",
    "supertest": "7.0.0"
  }
}
